{
    "name": "SparxSolver V2",
    "version": "3.6.2",
    "description": "Patch for SparxSolver!",
    "manifest_version": 3,
    "author": "Rosie",

    "icons": {
        "128": "assets/logo.png"
    },

    "action": {
        "default_icon": {
            "128": "assets/logo.png"
        },
        "default_title": "SparxSolver V2"
    },

    "permissions": [
        "declarativeNetRequest",
        "storage"
    ],

    "host_permissions": [
        "*://*.sparx-learning.com/*",
        "https://www.sparx-learning.com/*",
        "*://auth.sparx-learning.com/*"
    ],

    "content_scripts": [
        {
            "js": [ "index.js" ],
            "matches": [ "https://*.sparx-learning.com/*", "sparx-learning.com/*" ],
            "run_at": "document_start"
        }
    ],

    "externally_connectable": {
        "matches": [ "https://*.sparx-learning.com/*", "https://sparx-learning.com/*" ]
    },

    "web_accessible_resources": [
        {
            "resources": [
                "bundle.js",
                "cute.css",
                "core.css"
            ],
            "matches": [
                "https://*.sparx-learning.com/*"
            ]
        }
    ],

    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "azalea-remove-csp",
                "enabled": true,
                "path": "headers.json"
            }
        ]
    }
}
